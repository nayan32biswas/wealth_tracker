        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"asset\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"asset_group_id\" INTEGER NOT NULL REFERENCES asset_group (id), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"initial_balance\" INTEGER NOT NULL DEFAULT 0, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "category",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"category\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"type\" TEXT NOT NULL CHECK(\"type\" IN ('income', 'expense')), \"fee_type\" TEXT NOT NULL DEFAULT 'none' CHECK(\"fee_type\" IN ('none', 'percent', 'fixed')), \"fee_value\" INTEGER NOT NULL DEFAULT 0, \"is_deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_deleted\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "recurring_rule",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recurring_rule\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"note\" TEXT NULL, \"type\" TEXT NOT NULL CHECK(\"type\" IN ('income', 'expense', 'transfer')), \"amount\" INTEGER NOT NULL, \"fee\" INTEGER NOT NULL DEFAULT 0, \"asset_id\" INTEGER NOT NULL REFERENCES asset (id), \"to_asset_id\" INTEGER NULL REFERENCES asset (id), \"category_id\" INTEGER NULL REFERENCES category (id), \"frequency\" TEXT NOT NULL CHECK(\"frequency\" IN ('daily', 'weekly', 'monthly', 'yearly')), \"interval\" INTEGER NOT NULL DEFAULT 1, \"start_date\" TEXT NOT NULL, \"end_date\" TEXT NULL, \"next_date\" TEXT NOT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"is_deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_deleted\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "transaction",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transaction\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"note\" TEXT NULL, \"time\" INTEGER NOT NULL, \"date\" TEXT NOT NULL, \"type\" TEXT NOT NULL CHECK(\"type\" IN ('income', 'expense', 'transfer')), \"amount\" INTEGER NOT NULL CHECK(\"amount\" IS NOT 0 AND (NOT (\"type\" = 'transfer') OR \"amount\" > 0)), \"fee\" INTEGER NOT NULL DEFAULT 0 CHECK(\"fee\" >= 0), \"asset_id\" INTEGER NOT NULL REFERENCES asset (id), \"to_asset_id\" INTEGER NULL REFERENCES asset (id), \"category_id\" INTEGER NULL REFERENCES category (id), \"recurring_rule_id\" INTEGER NULL REFERENCES recurring_rule (id), UNIQUE (\"recurring_rule_id\", \"date\"));"
        }
      ]
    },
