          "sql": "CREATE TABLE IF NOT EXISTS \"asset_group\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"type\" TEXT NOT NULL DEFAULT 'asset' CHECK(\"type\" IN ('asset', 'liability')));"
